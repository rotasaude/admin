# Base da API admin. Em dev, fica em /admin/api e Vite proxa pro Rails.
VITE_ADMIN_API_BASE=/admin/api

# Base do endpoint de sessão (POST/GET/DELETE /session). Mesmo proxy.
VITE_SESSION_BASE=/session

# Em dev, alvo do proxy (Rails container exposto em 3030).
VITE_API_PROXY_TARGET=http://localhost:3030

# Operador de dev do console — criado/recriado pela semente (idempotente):
#   docker compose exec api bin/rails db:seed
# Acesso: http://admin.localhost:5174/admin/ → dev@local / dev-password + código
# TOTP (otp_secret fixo de dev, trocável via DEV_OPERATOR_OTP_SECRET). A senha
# pode ser trocada via DEV_USER_PASSWORD; ver apps/api/db/seeds.rb.
